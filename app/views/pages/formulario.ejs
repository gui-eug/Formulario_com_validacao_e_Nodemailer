<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Formulario</title>
</head>
<body>
<h1>Contato</h1>

<% erros.forEach(erro => { %>
    <p style="color: red;"><%= erro.msg %></p>
<% }); %>

<p><%= retorno || "" %></p>

<p><%= retorno || "" %></p>
   
    <form action="/formulario" method="post" novalidate>
        <div>
        <label for="name">Nome:</label>
        <input type="text"
        name="nome"
        id="name"
        placeholder="Coloque seu nome"/>
    </div>
    

    <div>
        <label for="email">Email:</label>
        <input type="email"
        id="email"
        name="email"
        placeholder="Coloque sua email"/>
    </div>

    <div>
        <label for="telefone">Telefone:</label>
        <input type="tel"
        id="telefone"
        name="telefone"
        placeholder="Coloque seu telefone"/>
        
    </div>

    <div>
        <label for="assunto">Assunto:</label>
        <input type="text"
        name="assunto"
        id="assunto"
        placeholder="Digite o assunto aqui"/>
    </div>

   <div>
    <label for="mensagem">Mensagem:</label>
    <textarea
        name="mensagem"
        id="mensagem"
        placeholder="Digite sua mensagem aqui"
        rows="5">
    </textarea>
    </div>

    <button type="submit">Enviar</button>

</form>

    
</body>
</html>